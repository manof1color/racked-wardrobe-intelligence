{
  "name": "racked-wardrobe-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:a11y": "playwright test",
    "eval:run": "node --experimental-strip-types scripts/run-garment-evaluation.mjs",
    "eval:score": "node --experimental-strip-types scripts/score-garment-evaluation.mjs",
    "eval:audit-labels": "node --experimental-strip-types scripts/audit-second-hand-label-coverage.mjs",
    "eval:live:build": "node --experimental-strip-types scripts/build-live-evaluation-set.mjs",
    "eval:live": "node --experimental-strip-types scripts/run-live-detection-evaluation.mjs",
    "verify:demo-match": "node --experimental-strip-types scripts/verify-test-cohort-match.mjs",
    "seed:judge:dry": "node scripts/seed-judge-accounts.mjs --dry-run",
    "seed:judge": "node scripts/seed-judge-accounts.mjs",
    "verify:judge": "node scripts/verify-judge-accounts.mjs",
    "usage:snapshot": "node scripts/pilot-usage-snapshot.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:aws": "node scripts/verify-aws.mjs",
    "brands:pending": "node scripts/brand-approval.mjs pending",
    "brands:list": "node scripts/brand-approval.mjs list",
    "brands:approve": "node scripts/brand-approval.mjs approve",
    "brands:revoke": "node scripts/brand-approval.mjs revoke",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-dynamodb": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-sesv2": "3.1160.0",
    "@aws-sdk/lib-dynamodb": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
