# Required: generate a unique 32+ character value for every deployed environment.
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production default uses Amazon Bedrock through the Amplify compute role.
AI_PROVIDER=bedrock
AI_API_KEY=
AI_MODEL=amazon.nova-lite-v1:0
AI_BACKGROUND_REMOVAL_MODEL=us.stability.stable-image-remove-background-v1:0
AI_BRAND_MODEL=amazon.nova-lite-v1:0
AI_HANGER_MODEL=
# Whole-look detection only. Racked uses the stronger US Nova Pro profile for crowded
# racks and overlapping outfits while routine AI calls remain on Nova Lite.
AI_LOOK_DETECTION_MODEL=us.amazon.nova-pro-v1:0

# AWS production storage (never commit account-specific values).
AWS_REGION=us-east-2
RACKED_TABLE_NAME=
RACKED_UPLOAD_BUCKET=

# Password reset email. The sender must be verified in Amazon SES; sandbox
# accounts can deliver only to verified recipient addresses.
RACKED_PASSWORD_RESET_FROM=
RACKED_PUBLIC_ORIGIN=http://localhost:3000
# New-brand alerts to the owner (docs/brand-approval.md): up to three comma-separated addresses.
# Sent from RACKED_BRAND_ALERT_FROM, or RACKED_PASSWORD_RESET_FROM; either must be SES-verified.
RACKED_BRAND_ALERT_TO=
RACKED_BRAND_ALERT_FROM=

# Content Security Policy. Enforced by default; set to "report" only to roll back to
# report-only while a violation is investigated (lib/content-security-policy.ts).
RACKED_CSP_MODE=
