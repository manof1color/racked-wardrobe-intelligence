# Required: generate a unique 32+ character value for every deployed environment.
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Anthropic vision provider. The app uses a labeled deterministic fallback when absent.
# Use the pinned Haiku 4.5 model by default; override only after reviewing model deprecations.
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# AWS deployment placeholders (never commit real values).
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DYNAMODB_TABLE_NAME=
WARDROBE_UPLOAD_BUCKET=
